# Multi-stage web build for the agent-hub frontend.
# Bun-based Vite build followed by a minimal static web image.
# serves the static dist/ via nginx with a SPA fallback. The nginx layer also
# proxies /api/* to the Node.js backend so the browser sees a single origin.
FROM oven/bun:1.3.14 AS builder
WORKDIR /app
COPY web/package.json web/bun.lock* ./
RUN bun install --frozen-lockfile
COPY web/ ./
RUN bun run build

FROM nginx:alpine AS runtime
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/nginx.conf
EXPOSE 80

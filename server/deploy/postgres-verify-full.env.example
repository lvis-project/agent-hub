# Copy this file to the ignored deploy/postgres-verify-full.env file. Replace every
# placeholder with operator-managed values; do not commit the resulting file or CA.
# The hostname must be the DNS name present in the PostgreSQL server certificate.
AGENT_HUB_DB_URL=postgresql://replace-user:replace-password@replace-with-your-postgres-dns-name:5432/replace-database-name
# The opt-in Compose overlay forces this mode and mounts the CA at the path below.
AGENT_HUB_POSTGRES_TLS_MODE=verify-full
AGENT_HUB_POSTGRES_TLS_CA_FILE=/run/secrets/agent_hub_postgres_ca
AGENT_HUB_POSTGRES_TLS_CA_HOST_FILE=/absolute/path/to/operator-managed-postgres-root-ca.pem

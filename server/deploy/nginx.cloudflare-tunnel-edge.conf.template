# Use only with docker-compose.cloudflare-tunnel-edge.yml on a Linux Docker
# bridge. Host cloudflared reaches the loopback-published port through the one
# verified immediate peer configured as CLOUDFLARED_TUNNEL_PEER_IP.
#
# The loopback port authenticates the host boundary, not a particular process.
# Restrict host-local access and do not use this on a shared or multi-tenant host.
events {}

http {
  include /etc/nginx/mime.types;

  server {
    listen 80 default_server;
    server_name _;

    set_real_ip_from ${CLOUDFLARED_TUNNEL_PEER_IP};
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    location / {
      proxy_pass http://web:80;
      proxy_http_version 1.1;
      # The public edge is HTTPS even though cloudflared reaches this loopback
      # origin over HTTP, so static responses advertise HTTPS-only transport.
      add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
      proxy_set_header Host $host;
      # $remote_addr is normalized from the one trusted peer. Overwrite, never
      # append, every client-supplied forwarding header.
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header CF-Connecting-IP "";
    }
  }
}

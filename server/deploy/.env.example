# Copy to deploy/.env and replace every placeholder before starting Docker Compose.
POSTGRES_USER=agent_hub
# For a real password with reserved URL characters, put its percent-encoded form in the DSN below.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=agent_hub
AGENT_HUB_DB_URL=postgresql://agent_hub:replace-with-a-long-random-password@postgres:5432/agent_hub
# The bundled Compose PostgreSQL service is a private, local development default.
# Explicit policy for the bundled private Compose PostgreSQL service only. PostgreSQL
# never silently defaults to disabled; do not set AGENT_HUB_POSTGRES_TLS_CA_FILE unless
# using the separate verify-full overlay.
AGENT_HUB_POSTGRES_TLS_MODE=disabled
AGENT_HUB_CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
# Keep this aligned with the private Compose network or set a narrower trusted proxy CIDR.
AGENT_HUB_TRUST_PROXY=172.30.0.0/24

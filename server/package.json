{
  "name": "agent-hub-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Hub public knowledge-network API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvis-project/agent-hub.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/lvis-project/agent-hub/issues"
  },
  "homepage": "https://github.com/lvis-project/agent-hub#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node --import tsx src/cli/migrate.ts",
    "provision": "node --import tsx src/cli/provision.ts",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:postgres-tls-contract": "node node_modules/vitest/vitest.mjs run test/postgres-tls-contract.test.ts",
    "test:a2a-p4-5:db:sqlite": "node --import tsx scripts/a2a-p4-5-db-parity.mjs sqlite",
    "test:a2a-p4-5:db:postgres": "node --import tsx scripts/a2a-p4-5-db-parity.mjs postgres"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "fastify": "^5.9.0",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "overrides": {
    "@types/node": "22.20.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  }
}

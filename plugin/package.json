{
  "name": "agent-hub-mcp",
  "version": "2.0.0",
  "description": "Agent Hub MCP server and MCP App dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvis-project/agent-hub.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/lvis-project/agent-hub/issues"
  },
  "homepage": "https://github.com/lvis-project/agent-hub#readme",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/mcp/server.d.ts",
  "bin": {
    "agent-hub-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/server.js"
    },
    "./stdio": {
      "types": "./dist/mcp/stdio.d.ts",
      "import": "./dist/stdio.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --clean && tsc --emitDeclarationOnly && node scripts/check-package-artifacts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/stdio.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.13"
  },
  "private": true
}
